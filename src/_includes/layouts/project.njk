---
layout: layouts/base.njk
nav: work
styles: [project]
scripts: [project]
---
{#-
  Project page template. A project file sets these in its front matter:
    title, description, kicker, engine, class
    folder:  the project's folder name under img/projects/ and video/projects/
    hero:    { img, alt, pos }   img can be short ("03") when it's in the folder
    intro:   HTML paragraphs       cta: { label, url }   (optional)
    specs:   list of [label, value] rows; a value of "TODO" shows as a reminder
    sections: list of { title, note, layout: stack|pair, items: [...] }
      each item is { src: "03", alt, cap } for an image
               or { video: "clip1", poster: "01", cap } for a looping video
      add  wide: true  to make an item span both columns in a pair
  The "Next project" banner follows the order in _data/work.json automatically.
  Anything written below the front matter is added after the sections.
-#}
{%- set n = work | workIndex(page.url) -%}
<section class="p-hero">
  <div class="p-info">
    <a href="/#work" class="back">← All work</a>
    <div class="p-name">
      <div class="kicker">{{ kicker }}{% if n > 0 %} · {{ n | pad }}{% endif %}</div>
      <h1>{{ title }}</h1>
    </div>
    <dl class="p-props">
      <div><dt>Object</dt><dd>{{ title | asset }}</dd></div>
      <div><dt>Engine</dt><dd>{{ engine }}</dd></div>
      <div><dt>Class</dt><dd>{{ class }}</dd></div>
    </dl>
  </div>
  <div class="p-frame">
    <img src="{{ hero.img | pimg(folder) }}" alt="{{ hero.alt }}"{% if hero.pos %} style="object-position: {{ hero.pos }}"{% endif %}>
    <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
    <div class="gizmo" aria-hidden="true"><i class="x"></i><i class="y"></i><i class="z"></i></div>
  </div>
</section>

<div class="wrap overview">
  <div class="reveal">
    {{ intro | safe }}
    {% if cta %}<a class="cta" href="{{ cta.url }}" target="_blank" rel="noopener">{{ cta.label }} →</a>{% endif %}
  </div>
  {% if specs %}
  <dl class="specs reveal">
    {%- for row in specs %}
    <div><dt>{{ row[0] }}</dt><dd{% if row[1] == "TODO" %} class="todo"{% endif %}>{{ row[1] | safe }}</dd></div>
    {%- endfor %}
  </dl>
  {% endif %}
</div>

{%- for s in sections %}
<section class="block wrap">
  <div class="s-head"><h2 data-n="{{ loop.index | pad }}">{{ s.title }}</h2>{% if s.note %}<span>{{ s.note }}</span>{% endif %}</div>
  <div class="{{ s.layout or 'stack' }}">
    {%- for m in s.items %}
    {%- set crop %}{% if m.ratio %}aspect-ratio: {{ m.ratio }};{% endif %}{% if m.pos %} object-position: {{ m.pos }};{% endif %}{% endset %}
    <figure class="reveal{% if m.wide %} wide{% endif %}"{% if s.layout == "row" %} style="flex-grow: {{ m.ratio or 1.7778 }}"{% endif %}><div class="media">
      {#- YouTube: a link card rather than an embed (age-restricted videos can't play off YouTube) -#}
      {%- if m.youtube %}<a class="yt" href="https://www.youtube.com/watch?v={{ m.youtube }}{% if m.start %}&amp;t={{ m.start }}s{% endif %}" target="_blank" rel="noopener">
        <img src="{{ m.poster | pimg(folder) }}" alt="" loading="lazy">
        <span class="yt-play"><i aria-hidden="true"></i><b>{{ m.label or "Watch on YouTube" }}</b><small>{% if m.start %}From {{ (m.start / 60) | round(0, "floor") }}:{{ m.start % 60 | pad }} · {% endif %}{{ m.note or "Opens YouTube" }}</small></span>
      </a>
      {%- elif m.video %}<video data-src="{{ m.video | pvid(folder) }}"{% if m.poster %} poster="{{ m.poster | pimg(folder) }}"{% endif %} muted loop playsinline preload="none"{% if m.alt %} aria-label="{{ m.alt }}"{% endif %}{% if crop %} style="{{ crop | trim }}"{% endif %}></video>
      {%- else %}<img src="{{ m.src | pimg(folder) }}" alt="{{ m.alt }}" loading="lazy">{% endif -%}
    </div>{% if m.cap %}<figcaption>{{ m.cap | safe }}</figcaption>{% endif %}</figure>
    {%- endfor %}
  </div>
</section>
{%- endfor %}

{{ content | safe }}

{%- set nx = work | nextProject(page.url) %}
{%- if nx %}
{%- set nxPage = collections.project | pageByUrl(nx.url) %}
<a class="next" href="{{ nx.url }}">
  <img src="{{ (nxPage.data.hero.img | pimg(nxPage.data.folder)) if nxPage else nx.img }}" alt="" loading="lazy">
  <div><small>Next project →</small><strong>{{ nx.title }}</strong></div>
</a>
{%- endif %}

<div class="lb" role="dialog" aria-label="Image viewer"><button aria-label="Close">×</button><img alt=""><video muted loop playsinline controls></video></div>
