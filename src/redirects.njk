---
# Keeps links to the old site's pages (e.g. johns3d.art/HoverBike.html) working.
# Edit _data/redirects.json to change where each one goes.
pagination: { data: redirects, size: 1, alias: r }
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Moved</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ site.url }}{{ r.to }}">
<meta http-equiv="refresh" content="0; url={{ r.to }}">
<script>location.replace("{{ r.to }}")</script>
</head>
<body><a href="{{ r.to }}">This page has moved.</a></body>
</html>
